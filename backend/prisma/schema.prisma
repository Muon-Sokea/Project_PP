generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  Supervisor
  Admin
  Organizer
  Attendee
}

enum UserStatus {
  active
  suspended
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TicketStatus {
  confirmed
  cancelled
  pending
}

enum RefundStatus {
  pending
  approved
  rejected
}

model User {
  id            Int           @id @default(autoincrement())
  firstName     String
  lastName      String
  email         String        @unique
  password      String
  googleId      String?       @unique
  telegramId    String?       @unique
  avatar        String        @default("")
  phone         String        @default("")
  address       String        @default("")
  role          Role          @default(Attendee)
  status        UserStatus    @default(active)
  otpCode       String?
  otpExpiresAt  DateTime?
  notificationPrefs Json    @default("{}")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  events        Event[]       @relation("OrganizerEvents")
  tickets       Ticket[]
  refunds       Refund[]
  testimonials  Testimonial[]
  bookmarks     Bookmark[]
  notifications Notification[]
  loginEvents   LoginEvent[]
}

// One row per successful login (password/Google/Telegram) — powers the real
// "Security Activity" feed. No geo-IP lookup and no session revocation by
// design (see backend/src/routes/settings.js for the IP/device parsing).
model LoginEvent {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  ip        String   @default("")
  device    String   @default("")
  method    String   @default("password")
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model Event {
  id              Int            @id @default(autoincrement())
  title           String
  description     String         @default("")
  date            DateTime
  time            String         @default("")
  location        String
  capacity        Int            @default(100)
  price           Decimal        @default(0) @db.Decimal(10, 2)
  category        String         @default("General")
  image           String         @default("")
  agenda          Json           @default("[]")
  // Optional organizer-set discount promo — one per event, redeemed at
  // checkout in EventRegistrationPage. Null/0 means no active promotion.
  promoCode            String?
  promoDiscountPercent Int?
  published       Boolean        @default(false)
  approvalStatus  ApprovalStatus @default(PENDING)
  // A draft is saved to the organizer's own dashboard only — approvalStatus
  // is inert while this is true (no admin notification, never returned by
  // any admin-facing query). Flipped to false only via POST /:id/submit,
  // which is the one moment it actually enters the approval workflow.
  isDraft         Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  organizer   User      @relation("OrganizerEvents", fields: [organizerId], references: [id])
  organizerId Int

  tickets     Ticket[]
  testimonials Testimonial[]
  bookmarks   Bookmark[]
  ticketTypes TicketType[]

  @@index([organizerId, createdAt])
  @@index([createdAt])
  @@index([organizerId])
  @@index([approvalStatus])
}

model TicketType {
  id          Int      @id @default(autoincrement())
  name        String
  price       Decimal  @default(0) @db.Decimal(10, 2)
  quantity    Int      @default(0)
  description String   @default("")
  createdAt   DateTime @default(now())

  event   Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId Int

  tickets Ticket[]

  @@index([eventId])
}

model Bookmark {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  user   User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int
  event  Event @relation(fields: [eventId], references: [id])
  eventId Int

  @@unique([userId, eventId])
  @@index([userId, createdAt])
}

model Ticket {
  id           Int          @id @default(autoincrement())
  ticketCode   String       @unique @default(uuid())
  ticketType   String       @default("standard")
  quantity     Int          @default(1)
  price        Decimal      @default(0) @db.Decimal(10, 2)
  promoCodeUsed String?     // the code applied at checkout, if any — kept for the record even if the event's code later changes
  status       TicketStatus @default(confirmed)
  registeredAt DateTime     @default(now())
  reminderSentAt DateTime?  // set once the "1 day before" reminder email goes out — prevents duplicate sends

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       Int
  event        Event        @relation(fields: [eventId], references: [id])
  eventId      Int

  ticketTypeRef   TicketType? @relation(fields: [ticketTypeId], references: [id], onDelete: SetNull)
  ticketTypeId    Int?

  refund       Refund?

  @@index([status])
  @@index([eventId, status])
}

model Refund {
  id          Int          @id @default(autoincrement())
  ticketCode  String       @unique
  eventName   String
  reason      String
  details     String       @default("")
  status      RefundStatus @default(pending)
  requestedAt DateTime     @default(now())
  resolvedAt  DateTime?

  ticket      Ticket       @relation(fields: [ticketCode], references: [ticketCode], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      Int
}

model Testimonial {
  id        Int      @id @default(autoincrement())
  content   String
  rating    Int
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  event     Event?   @relation(fields: [eventId], references: [id])
  eventId   Int?
}

model Notification {
  id        Int      @id @default(autoincrement())
  type      String
  title     String
  message   String   @default("")
  link      String   @default("")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int

  @@index([userId, read, createdAt])
}

model HealthCheck {
  id          Int      @id @default(autoincrement())
  cpuUsed     Float    @default(0)
  memUsed     Float    @default(0)
  diskUsed    Float    @default(0)
  loadAvg     Float    @default(0)
  services    Json     @default("[]")
  createdAt   DateTime @default(now())

  @@index([createdAt])
}
