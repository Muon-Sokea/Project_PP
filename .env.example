# ══════════════════════════════════════════════════════════════════
#  Root .env.example — Planning Center (ERMS)
#  Copy this file to backend/.env and frontend/.env, then fill in
#  your own values. NEVER commit real .env files to git.
# ══════════════════════════════════════════════════════════════════

# ── Backend (backend/.env) ─────────────────────────────────────

# Server
PORT=4000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/erms?schema=public

# JWT Authentication
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Google OAuth
GOOGLE_CLIENT_ID=10502513068-hto1p7b4b7pja4ovp8o00a9rfm2htbqj.apps.googleusercontent.com

# Telegram Login (bot token from @BotFather — keep secret)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Redis (optional — token blacklist disabled without it)
REDIS_URL=

# CORS — frontend origin
FRONTEND_URL=http://localhost:5173

# SMTP (email verification & password reset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="Planning Center" <your-email@gmail.com>


# ── Frontend (frontend/.env) ───────────────────────────────────

# Google OAuth Client ID (get from Google Cloud Console)
VITE_GOOGLE_CLIENT_ID=

# Telegram bot username (public @handle, no @ prefix) for the Login Widget
VITE_TELEGRAM_BOT_USERNAME=

# Backend API base URL (no trailing /api)
# Local dev with Vite proxy → leave empty
# Production → set to your backend URL
VITE_API_BASE=
